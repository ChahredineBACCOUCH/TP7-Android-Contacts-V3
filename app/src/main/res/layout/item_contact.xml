<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de la liste : photo ronde, prénom + nom, téléphone -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPhoto"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/desc_photo"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/FormeCercle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNomComplet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTelephone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texte_secondaire"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
